<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree -->
    <record id="view_practice_student_tree" model="ir.ui.view">
        <property name="name">practice.student.tree</property>
        <property name="model">practice.student</property>
        <property name="arch" type="xml">
            <tree string="Estudiantes">
                <field name="name"/>
                <field name="age"/>
                <field name="email"/>
                <field name="enrollment_date"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </property>
    </record>

    <!-- Vista Form -->
    <record id="view_practice_student_form" model="ir.ui.view">
        <property name="name">practice.student.form</property>
        <property name="model">practice.student</property>
        <property name="arch" type="xml">
            <form string="Estudiante">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="age"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="enrollment_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Agregue observaciones aquí..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </property>
    </record>

    <!-- Acción -->
    <record id="action_practice_student" model="ir.actions.act_window">
        <property name="name">Estudiantes</property>
        <property name="type">ir.actions.act_window</property>
        <property name="res_model">practice.student</property>
        <property name="view_mode">tree,form</property>
        <property name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree su primer estudiante.
            </p>
        </property>
    </record>

    <!-- Menús -->
    <menuitem id="menu_practice_student_root" name="Práctica Odoo" sequence="10"/>
    <menuitem id="menu_practice_student_management" name="Gestión" parent="menu_practice_student_root" sequence="10"/>
    <menuitem id="menu_practice_student_list" name="Estudiantes" parent="menu_practice_student_management" action="action_practice_student" sequence="10"/>
</odoo>
